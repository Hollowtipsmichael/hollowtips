// Hollowtips Verify — Prisma schema
// Local dev uses SQLite. For production, switch `provider` to "postgresql"
// and point DATABASE_URL at your Postgres instance (see .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth ──────────────────────────────────────────────────
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
}

// ─── Catalog ───────────────────────────────────────────────
model Product {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  sku             String? // A1–A10 (flavor SKU)
  size            String?  @default("2G")
  strainName      String?
  productType     String? // INDICA | SATIVA | HYBRID (packaging badge)
  description     String?
  videoUrl        String?
  artworkUrl      String?
  productImageUrl String?
  ingredients     String? // long text
  warningText     String? // long text
  socialLinks     String? // JSON string (SQLite has no Json type); parse in code
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  variants          ProductVariant[]
  verificationCodes VerificationCode[]
  scanEvents        ScanEvent[]
  emailCaptures     EmailCapture[]
}

// ─── Variants (flavors) ────────────────────────────────────
// A product can have multiple variants; verification codes are generated per
// variant. Each variant can carry its own strain + artwork for the verify page.
model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  strainName      String?
  productType     String? // optional override of Product.productType
  artworkUrl      String?
  productImageUrl String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  verificationCodes VerificationCode[]

  @@index([productId])
}

// ─── Verification ──────────────────────────────────────────
// NOTE: SQLite (local dev) does not support Prisma native enums, so enum-like
// fields are stored as String. Allowed values are enforced in code via the
// constants/types in `src/lib/enums.ts`. When moving to PostgreSQL you may
// convert `status` / `deviceType` to real `enum` types if desired.
// CodeStatus values: "UNUSED" | "VERIFIED" | "FLAGGED"
model VerificationCode {
  id             String    @id @default(cuid())
  code           String          @unique
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  status         String          @default("UNUSED") // CodeStatus
  firstScannedAt DateTime?
  scanCount      Int             @default(0)
  createdAt      DateTime        @default(now())

  scanEvents ScanEvent[]

  @@index([code])
  @@index([productId])
  @@index([variantId])
}

// ─── Scans ─────────────────────────────────────────────────
// DeviceType values: "IPHONE" | "ANDROID" | "DESKTOP" | "OTHER" (see note above).
model ScanEvent {
  id          String           @id @default(cuid())
  codeId      String
  code        VerificationCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  productId   String
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  ipAddress   String?
  country     String?
  region      String?
  city        String?
  latitude    Float?
  longitude   Float?
  deviceType  String           @default("OTHER") // DeviceType
  userAgent   String?
  isFirstScan Boolean          @default(false)
  scannedAt   DateTime         @default(now())

  @@index([codeId])
  @@index([productId])
}

// ─── Marketing ─────────────────────────────────────────────
model EmailCapture {
  id         String   @id @default(cuid())
  email      String
  name       String?
  phone      String?
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  capturedAt DateTime @default(now())

  @@index([productId])
}

// ─── Media / Trailers ──────────────────────────────────────
model MediaItem {
  id           String    @id @default(cuid())
  title        String
  type         String    @default("video") // "video" | "download" | "wallpaper"
  category     String // tab on the public page
  videoUrl     String    @default("") // video: external URL or /uploads/<file>.mp4
  fileUrl      String? // download/wallpaper: the downloadable asset/image
  thumbnailUrl String?
  publishedAt  DateTime?
  isNew        Boolean   @default(false)
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([category])
}
