# ─── Database ───────────────────────────────────────────────
# Local dev uses SQLite. The Prisma schema's datasource provider is "sqlite".
DATABASE_URL="file:./dev.db"

# For production (PostgreSQL): switch prisma/schema.prisma datasource
# provider to "postgresql" and use a URL like:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hollowtips?schema=public"

# ─── NextAuth (Auth.js v4) ──────────────────────────────────
# Generate a strong secret: `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ─── Mailchimp (master list for The Chamber captures) ───────
# Optional — leads always save to the DB. Set both to sync to Mailchimp.
# API key format ends with the datacenter, e.g. "...-us21".
MAILCHIMP_API_KEY=""
MAILCHIMP_AUDIENCE_ID=""
